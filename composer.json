{
    "name": "mrsafalpiya/strictly-laravel",
    "description": "Strictly Laravel: end-to-end type safety for Laravel + Inertia + React, applied as an Overlay on the official React starter kit.",
    "type": "library",
    "license": "MIT",
    "version": "0.3.0",
    "homepage": "https://github.com/mrsafalpiya/strictly-laravel",
    "support": {
        "issues": "https://github.com/mrsafalpiya/strictly-laravel/issues",
        "source": "https://github.com/mrsafalpiya/strictly-laravel/tree/main/packages/laravel"
    },
    "require": {
        "php": "^8.4",
        "illuminate/console": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0",
        "inertiajs/inertia-laravel": "^3.0",
        "larastan/larastan": "^3.9",
        "nette/neon": "^3.4",
        "pestphp/pest-plugin-phpstan": "^5.2",
        "pestphp/pest-plugin-type-coverage": "^5.0",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-strict-rules": "^2.1",
        "spatie/laravel-data": "^4.23",
        "spatie/laravel-typescript-transformer": "^3.3",
        "tomasvotruba/type-coverage": "^2.5"
    },
    "conflict": {
        "laravel/boost": "<2.10 || >=3.0"
    },
    "suggest": {
        "laravel/boost": "Required as a dev dependency (composer require laravel/boost --dev): it installs the Strictly Laravel guidance for AI coding agents, and strictly:install checks it is there."
    },
    "autoload": {
        "psr-4": {
            "StrictlyLaravel\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "StrictlyLaravel\\StrictlyServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
