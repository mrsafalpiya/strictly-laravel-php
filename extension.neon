# The Strictly Laravel PHPStan extension. The app's phpstan.neon includes this file (Kit Conversion writes that
# include), so every setting and rule here reaches the app through `composer update`.
#
# The extensions below are included by path rather than through phpstan/extension-installer: Composer blocks that
# plugin unless the app allows it first, which would break a plain `composer require`. %rootDir% is
# vendor/phpstan/phpstan.

includes:
    - %rootDir%/../../larastan/larastan/extension.neon
    - %rootDir%/../../nesbot/carbon/extension.neon
    - %rootDir%/../phpstan-strict-rules/rules.neon
    - %rootDir%/../../tomasvotruba/type-coverage/config/extension.neon
    - %rootDir%/../../pestphp/pest-plugin-phpstan/extension.neon
    - phar://phpstan.phar/conf/bleedingEdge.neon

parameters:
    level: max

    # Problem P-037: read model casts from the casts() method, so enum and date casts aren't typed as strings.
    # Upstream: https://github.com/larastan/larastan/issues/2512 (drop this once Larastan reads casts() by default).
    parseModelCastsMethod: true

    # ADR-0007: a suppression names the identifiers it ignores and gives a reason for each,
    # `@phpstan-ignore strictly.rule (reason)`. A bare @phpstan-ignore-line or -next-line is rejected.
    reportIgnoresWithoutComments: true

    strictRules:
        # Eloquent builders and PHPUnit assertions forward static calls dynamically (User::where(...),
        # $this->markTestSkipped(...)): false positives.
        dynamicCallOnStaticMethod: false

    type_coverage:
        return: 100
        param: 100
        property: 100
        constant: 100

# Data conventions: concrete Data classes are final, and only Data classes live in App\Data. Pages are rendered only
# through Page classes (Problems P-009, P-011), and flash data is written only through the flash Data class (P-047).
# A Data class a controller action takes extends InputData (P-014, P-017), and so does a Data class with rules() nested
# in an input (P-099). Such an action authorizes in the input's authorize(), which runs before validation (P-030).
# Only an input's authorize() and rules() receive the route's bound models, so no other Data class's take one (P-126).
# Every property of a query Data class has the default an absent query key means (P-104, P-105), and a controller reads
# the query string only through one (P-106). A controller action takes an input class, never a FormRequest, and reads
# input from the request only beside an input or query class, whose Contract checks the keys it reads (P-112). A
# closure route, whose route function Wayfinder can't type, takes no input, query or other Data class or FormRequest, returns
# no Data class but a Page, and reads neither input nor the query string (P-097, P-109, P-151, P-167). A
# broadcast event's payload is the Data class its broadcastData() declares (P-052), and it declares the channels it is
# sent on with #[BroadcastsOn] (P-144). A translation call in PHP names a key of the default locale (or Laravel's own)
# with exactly its message's params, and picks a pluralised message's form with a choice call (P-137). A Data property
# that holds a model's key declares the model with #[KeyOf] (P-128).
rules:
    - StrictlyLaravel\PHPStan\DataClassFinalRule
    - StrictlyLaravel\PHPStan\DataNamespaceRule
    - StrictlyLaravel\PHPStan\InertiaRenderRule
    - StrictlyLaravel\PHPStan\InertiaFlashRule
    - StrictlyLaravel\PHPStan\InputDataRule
    - StrictlyLaravel\PHPStan\NestedInputDataRule
    - StrictlyLaravel\PHPStan\AuthorizeInInputRule
    - StrictlyLaravel\PHPStan\RouteModelParameterRule
    - StrictlyLaravel\PHPStan\QueryDefaultRule
    - StrictlyLaravel\PHPStan\QueryReadRule
    - StrictlyLaravel\PHPStan\InputReadRule
    - StrictlyLaravel\PHPStan\FormRequestRule
    - StrictlyLaravel\PHPStan\ClosureRouteRule
    - StrictlyLaravel\PHPStan\BroadcastDataRule
    - StrictlyLaravel\PHPStan\BroadcastsOnRule
    - StrictlyLaravel\PHPStan\TranslationRule
    - StrictlyLaravel\PHPStan\KeyOfRule

services:
    # The messages TranslationRule checks translation calls against, read once per run (P-137).
    - StrictlyLaravel\PHPStan\TranslationCatalog
